# Copier en .env.local (en local) — sur Vercel : Settings > Environment Variables
SESSION_SECRET=change-me-with-at-least-32-random-characters

# Facultatif : Vercel utilise automatiquement l'URL du projet si vide
APP_BASE_URL=http://localhost:3000

# "console" = pas de vrai SMS, le lien s'affiche dans le terminal/sur la page
# "orange"  = envoi réel via l'API SMS Orange
SMS_PROVIDER=console
# Sur Vercel, mettre true pour afficher le lien de test sur la page (démo)
SHOW_TEST_LINK=false

# Redis (obligatoire sur Vercel) — injecté automatiquement par l'intégration Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Uniquement si SMS_PROVIDER=orange
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER=+225XXXXXXXXXX
